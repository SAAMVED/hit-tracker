# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Required by the backend. The application never falls back to SQLite.
DATABASE_URL=postgresql://hittracker_user:change_me@localhost:5432/hit_tracker
# Optional dedicated database for isolated backend integration tests.
TEST_DATABASE_URL=postgresql://hittracker_user:change_me@localhost:5432/hit_tracker_test

# ── Users (created on first run if not already in DB) ─────────────────────────
COMMANDER_PASSWORD=Commander@NSG1
VIEWER_PASSWORD=Viewer@NSG1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
